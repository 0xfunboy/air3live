# Generate separate tokens with npm run init. Never expose producer credentials to the page.
AIR3_HOST=127.0.0.1
AIR3_PORT=5890
AIR3_PRODUCER_TOKEN=GENERATE_PRODUCER_TOKEN
AIR3_PLAYER_TOKEN=GENERATE_PLAYER_TOKEN
AIR3_OPERATOR_TOKEN=GENERATE_OPERATOR_TOKEN
AIR3_LIVE_ENABLED=true
# Local loopback access is automatic. Remote access needs the operator token and
# an explicit HTTPS origin (for example https://studio.example.com), no path.
AIR3_LOCAL_OPERATOR=true
AIR3_PUBLIC_ORIGIN=
AIR3_DATA_DIR=./data

# OpenAI-compatible server, including the /v1 prefix. Model remains resident remotely.
AIR3_TTS_BASE_URL=http://127.0.0.1:8880/v1
AIR3_TTS_API_KEY=
AIR3_TTS_MODEL=kokoro
AIR3_TTS_VOICE_EN=af_jessica
AIR3_TTS_VOICE_IT=if_sara
AIR3_TTS_SPEED=1
AIR3_TTS_TIMEOUT_MS=60000
AIR3_TTS_CHUNK_CHARS=600
# CPU audio alignment, bundled for Windows/Linux x64. 'required' rejects jobs
# when alignment fails; 'auto' reports an amplitude fallback explicitly.
AIR3_LIPSYNC_MODE=auto
AIR3_RHUBARB_PATH=
AIR3_LIPSYNC_TIMEOUT_MS=45000
AIR3_LIPSYNC_THREADS=2
AIR3_QUEUE_LIMIT=20
AIR3_MAX_TEXT_CHARS=8000
AIR3_NARRATION_TTL_MS=300000
AIR3_PLAYER_LEASE_MS=15000
AIR3_RETENTION_MS=3600000

# Public data only. Empty means explicitly unavailable, never invented financial data.
AIR3_DAPP_BASE_URL=https://airdapp.airewardrop.xyz
# The complete avatar is included in this package.
AIR3_AVATAR_URL=/assets/air3/models/AIR3-runtime.glb
AIR3_RENDER_QUALITY=high
AIR3_WIDTH=1920
AIR3_HEIGHT=1080
AIR3_FPS=30

# Default records locally. Publishing is activated explicitly with mode rtmp/rtsp.
AIR3_OUTPUT_MODE=file
AIR3_RECORDING_DIR=./recordings
AIR3_RTMP_URL=
AIR3_RTMP_KEY=
AIR3_RTSP_URL=
# auto probes NVENC, then Intel QuickSync, then libx264. Explicit: h264_nvenc | h264_qsv | libx264
AIR3_VIDEO_ENCODER=auto
AIR3_VIDEO_BITRATE_KBPS=4500
AIR3_CAPTURE_BITRATE_KBPS=10000
AIR3_MAX_CAPTURE_BUFFER_MB=16
AIR3_BROADCAST_DURATION_SECONDS=0
AIR3_MAX_RESTARTS=5
AIR3_FFMPEG=ffmpeg
# Empty uses the browser installed by npm run browser:install.
AIR3_CHROME_PATH=
AIR3_CHROME_ANGLE=default
AIR3_CHROME_NO_SANDBOX=false
# Set true only when a supervising process owns stdin and uses quit/EOF to stop.
AIR3_CONTROL_STDIN=false
# Set true for deployment. Empty defaults true for live output, false for recordings.
AIR3_REQUIRE_HARDWARE_RENDERING=
